# Secrets for HOST .5 (node1). Copy to `.env` (git-ignored) and fill with FRESH
# values. Compose refuses to start if any required one is unset.
#
# Generate a 32-byte hex secret:   head -c32 /dev/urandom | xxd -p -c32

# --- shared object store (MinIO) -------------------------------------------
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-value

# --- node1's Postgres password ---------------------------------------------
DB_PASSWORD=change-me-to-a-long-random-value

# --- shared node-to-node bearer token (SAME value on .4) -------------------
DEMOCRATOS_CLUSTER_TOKEN=change-me-run-head-c32-dev-urandom-xxd

# --- node1 Ed25519 identity (distinct from node2's) ------------------------
NODE1_SEED=change-me-run-head-c32-dev-urandom-xxd

# --- federation trust root PUBLIC key (SAME value on .4) -------------------
# From `democratos issuer root` (the SECRET seed stays OFFLINE — never here).
FEDERATION_TRUST_ROOT=change-me-from-issuer-root

# --- session signing secret (SAME value on .4) -----------------------------
# Shared so a login on either node is valid on the other. >=16 chars, not CHANGE_ME.
DEMOCRATOS_SESSION_SECRET=change-me-openssl-rand-hex-32

# --- admin invite-review-queue secret (?key= on /admin) --------------------
DEMOCRATOS_ADMIN_SECRET=change-me-run-head-c32-dev-urandom-xxd

# --- Caddy / Let's Encrypt (Cloudflare DNS-01) -----------------------------
CLOUDFLARE_API_TOKEN=change-me-cloudflare-zone-dns-edit-token
ACME_EMAIL=you@example.org

# --- SMTP (relay already configured on the box) ----------------------------
# Point these at the box's existing relay. Port 587 + STARTTLS, or 465 + set
# DEMOCRATOS_SMTP_STARTTLS=false for implicit TLS. If the relay runs on the HOST
# (e.g. postfix on 127.0.0.1:587), use host.docker.internal as the host and add
#   extra_hosts: ["host.docker.internal:host-gateway"]  to node1 in compose.
DEMOCRATOS_SMTP_HOST=change-me.smtp.host
DEMOCRATOS_SMTP_PORT=587
DEMOCRATOS_SMTP_STARTTLS=true
DEMOCRATOS_SMTP_USERNAME=change-me
DEMOCRATOS_SMTP_PASSWORD=change-me
DEMOCRATOS_SMTP_FROM=Democratos <no-reply@ratbum.com>

# --- optional: bind MinIO media onto a big disk ----------------------------
# MEDIA_DIR=/mnt/storage/democratos-media
