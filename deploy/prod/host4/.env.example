# Secrets for HOST .4 (node2). Copy to `.env` (git-ignored) and fill in.
# Several values MUST match host5/.env exactly (noted below).

# --- MinIO creds (MUST MATCH .5 — same shared bucket) ----------------------
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-value

# --- node2's OWN Postgres password (independent of .5) ---------------------
DB_PASSWORD=change-me-to-a-long-random-value

# --- cluster token (MUST MATCH .5) -----------------------------------------
DEMOCRATOS_CLUSTER_TOKEN=same-value-as-host5

# --- node2 Ed25519 identity (DISTINCT from node1's) ------------------------
NODE2_SEED=change-me-distinct-from-node1

# --- federation trust root PUBLIC key (MUST MATCH .5) ----------------------
FEDERATION_TRUST_ROOT=same-value-as-host5

# --- session signing secret (MUST MATCH .5) --------------------------------
DEMOCRATOS_SESSION_SECRET=same-value-as-host5

# --- admin queue secret (MUST MATCH .5) ------------------------------------
DEMOCRATOS_ADMIN_SECRET=same-value-as-host5

# --- Caddy / Let's Encrypt (Cloudflare DNS-01) -----------------------------
CLOUDFLARE_API_TOKEN=change-me-cloudflare-zone-dns-edit-token
ACME_EMAIL=you@example.org

# --- SMTP (same relay as .5, or this box's relay) --------------------------
DEMOCRATOS_SMTP_HOST=change-me.smtp.host
DEMOCRATOS_SMTP_PORT=587
DEMOCRATOS_SMTP_STARTTLS=true
DEMOCRATOS_SMTP_USERNAME=change-me
DEMOCRATOS_SMTP_PASSWORD=change-me
DEMOCRATOS_SMTP_FROM=Democratos <no-reply@ratbum.com>
