# Secrets for deploy/docker-compose.federation.yml.
#
# Copy this file to `deploy/.env` (git-ignored) and fill in FRESH random values.
# The compose file refuses to start if any of these is unset, so nothing ever
# runs with a committed/known credential.
#
# Generate a 32-byte hex value with:
#   head -c32 /dev/urandom | xxd -p -c32
#
# Each node needs its OWN distinct seed (its persistent Ed25519 signing identity).

# Object store (MinIO) root credentials — shared by the media bucket and the app.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-value

# Postgres password (both per-node databases use it).
DB_PASSWORD=change-me-to-a-long-random-value

# Shared node-to-node bearer token (authenticates the feed/command/ingest RPC).
DEMOCRATOS_CLUSTER_TOKEN=change-me-run-head-c32-dev-urandom-xxd

# Per-node Ed25519 seeds — one distinct 32-byte hex value per node. KEEP SECRET.
NODE1_SEED=change-me-run-head-c32-dev-urandom-xxd
NODE2_SEED=change-me-distinct-from-node1

# --- Private dev node (docker-compose.dev-federation.yml only) ---------------
# Seed for the extra dev node (node id 9). Distinct from the others.
NODE_DEV_SEED=change-me-distinct-from-the-others
# Secret that gates the account switcher: /dev/unlock?key=<this>. Only you should
# know it. The dev node refuses to boot on its non-loopback bind without it.
# Generate: head -c32 /dev/urandom | xxd -p -c32
DEMOCRATOS_DEV_UNLOCK_SECRET=change-me-run-head-c32-dev-urandom-xxd
# The fixed set of content "puppet" accounts the switcher may act as (comma-
# separated handles). Created franchise-BARRED on boot: they post content but can
# never become voters, and the switcher can reach no other account.
DEMOCRATOS_DEV_ACCOUNTS=seed-alice,seed-bob,seed-carol

# --- Media storage location (optional) ---------------------------------------
# Where the MinIO media bucket keeps its bytes. Leave UNSET to use a managed
# Docker volume. On a big-disk host (e.g. a Raspberry Pi with a multi-TB drive)
# set this to an absolute path on that drive to bind the media store onto it:
#   MEDIA_DIR=/mnt/storage/democratos-media
# The directory must exist and be writable by the container. Build for the Pi
# (arm64) with:  docker buildx build --platform linux/arm64 -t democratos:latest --load .
# MEDIA_DIR=

# --- OPTIONAL: etcd TLS / mutual TLS (control-plane hardening, H4) -----------
# The control plane is the ownership trust anchor. On an isolated fabric the
# compose relies on network isolation; for a multi-host or hostile-operator
# deployment, run etcd with TLS and per-node RBAC and point each node at it:
#   DEMOCRATOS_ETCD_CA=/etc/democratos/etcd-ca.pem       # verify the etcd server
#   DEMOCRATOS_ETCD_CERT=/etc/democratos/node.pem        # this node's client cert (mTLS)
#   DEMOCRATOS_ETCD_KEY=/etc/democratos/node-key.pem     # this node's client key  (mTLS)
#   DEMOCRATOS_ETCD_DOMAIN=etcd.internal                 # optional SNI override
# Then scope each node in etcd RBAC to its own keyspace (democratos/keys/<node>,
# democratos/nodes/<node>) so a compromised node can't forge another's writes,
# and switch DEMOCRATOS_ETCD_ENDPOINTS to https://…
