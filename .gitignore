
# federation test harness runtime state
deploy/test/.run/

# --- runtime secrets & user data (never commit; this project is forked & self-hosted) ---
# Env files hold the session secret, cluster token, node seeds, DB/S3 creds.
.env
.env.*
!.env.example
# The text-store data file contains user emails and Argon2 password hashes.
democratos.json
# Federation control-plane TLS material (internal CA, etcd server + client keys).
deploy/prod/etcd-certs/
deploy/prod/*/certs/
# Signed issuer certs and the OFFLINE federation root seed.
deploy/prod/*.issuer.json
deploy/prod/*.root-seed
# Shipped prebuilt image bundle (large binary artifact).
deploy/prod/*.tar.gz
# Derived recommender indexes and uploaded media.
*.recindex
media/
# Build artifacts.
target/
.DS_Store
# Backup copies of the text-store data file (emails + password hashes).
democratos.json.bak*
